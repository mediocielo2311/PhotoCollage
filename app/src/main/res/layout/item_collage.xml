<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">

    <ImageView
        android:id="@+id/ivCollage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#11000000"
        android:contentDescription="@string/descripcion_collage"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/vBordeCollage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/borde_seleccion"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/ivCollage"
        app:layout_constraintEnd_toEndOf="@id/ivCollage"
        app:layout_constraintStart_toStartOf="@id/ivCollage"
        app:layout_constraintTop_toTopOf="@id/ivCollage" />

</androidx.constraintlayout.widget.ConstraintLayout>
